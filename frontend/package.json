{
  "name": "inklore-workspace",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev:creator": "vite --no-open",
    "dev:admin": "vite --config vite.admin.config.ts --no-open",
    "dev": "vite --no-open",
    "build:creator": "tsc -b && vite build",
    "build:admin": "tsc -b && vite build --config vite.admin.config.ts",
    "build": "pnpm run build:creator && pnpm run build:admin",
    "codegen": "node ../scripts/codegen.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "@tiptap/extension-bubble-menu": "^2.11.5",
    "@tiptap/extension-character-count": "^3.32.2",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^3.32.2",
    "clsx": "^2.1.1",
    "cytoscape": "^3.34.4",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.0.2",
    "vite": "^8.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/cytoscape": "^3.21.9",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.0.9",
    "typescript": "^7.0.2"
  }
}
