{
 "components": {
  "schemas": {
   "Principal": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "user_id",
     "tenant_id",
     "display_name",
     "roles",
     "global_roles",
      "audience",
     "session_id",
     "user_revision"
    ],
    "properties": {
     "user_id": {
      "$ref": "./common.json#/components/schemas/UUID"
     },
     "tenant_id": {
      "$ref": "./common.json#/components/schemas/UUID"
     },
     "display_name": {
      "type": "string",
      "maxLength": 60
     },
     "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
       "enum": [
        "creator",
        "operator",
        "auditor"
       ]
      }
     },
     "global_roles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
       "enum": ["super_admin"]
      }
     },
     "audience": {
      "enum": [
       "creator",
       "admin"
      ]
     },
     "session_id": {
      "$ref": "./common.json#/components/schemas/UUID"
     },
     "user_revision": {
      "$ref": "./common.json#/components/schemas/Revision"
     }
    }
   },
   "TenantSummary": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name"],
    "properties": {
     "id": {"$ref": "./common.json#/components/schemas/UUID"},
     "name": {"type": "string", "minLength": 1, "maxLength": 120}
    }
   },
   "TenantCatalog": {
    "type": "array",
    "items": {"$ref": "#/components/schemas/TenantSummary"}
   },
   "SwitchTenant": {
    "type": "object",
    "additionalProperties": false,
    "required": ["tenant_id"],
    "properties": {
     "tenant_id": {"$ref": "./common.json#/components/schemas/UUID"}
    }
   },
   "Login": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "password",
     "audience"
    ],
    "properties": {
     "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254
     },
     "username": {
      "type": "string",
      "const": "root",
      "description": "Reserved identifier accepted for Creator and Admin login audiences."
     },
     "password": {
      "type": "string",
      "minLength": 6,
      "maxLength": 72,
      "writeOnly": true,
      "x-max-utf8-bytes": 72
     },
     "tenant_id": {
      "$ref": "./common.json#/components/schemas/UUID"
     },
     "audience": {
      "enum": [
       "creator",
       "admin"
      ]
     },
     "captcha_id": {
      "$ref": "./common.json#/components/schemas/UUID"
     },
     "captcha_code": {
      "type": "string",
      "minLength": 4,
      "maxLength": 4,
      "pattern": "^[23456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz]{4}$"
     }
    },
    "oneOf": [
     {
      "required": ["email"],
      "not": {"required": ["username"]}
     },
     {
      "required": ["username"],
      "not": {"required": ["email"]}
     }
    ],
    "dependentRequired": {
     "captcha_id": [
      "captcha_code"
     ],
     "captcha_code": [
      "captcha_id"
     ]
    }
   },
   "Captcha": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "captcha_id",
     "svg",
     "expires_in"
    ],
    "properties": {
     "captcha_id": {
      "$ref": "./common.json#/components/schemas/UUID"
     },
     "svg": {
      "type": "string",
      "contentMediaType": "image/svg+xml"
     },
     "expires_in": {
      "const": 180
     }
    }
   },
   "VerifyCaptcha": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "captcha_id",
     "captcha_code"
    ],
    "properties": {
     "captcha_id": {
      "$ref": "./common.json#/components/schemas/UUID"
     },
     "captcha_code": {
      "type": "string",
      "minLength": 4,
      "maxLength": 4,
      "pattern": "^[23456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz]{4}$"
     }
    }
   },
   "CaptchaVerification": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "valid"
    ],
    "properties": {
     "valid": {
      "const": true
     }
    }
   },
   "Register": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "email",
     "password",
     "pen_name"
    ],
    "properties": {
     "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254
     },
     "password": {
      "type": "string",
      "minLength": 6,
      "maxLength": 72,
      "writeOnly": true,
      "x-max-utf8-bytes": 72
     },
     "pen_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
     },
     "captcha_id": {
      "$ref": "./common.json#/components/schemas/UUID"
     },
     "captcha_code": {
      "type": "string",
      "minLength": 4,
      "maxLength": 4,
      "pattern": "^[23456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz]{4}$"
     }
    },
    "dependentRequired": {
     "captcha_id": [
      "captcha_code"
     ],
     "captcha_code": [
      "captcha_id"
     ]
    }
   },
   "ForgotPassword": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "email"
    ],
    "properties": {
     "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254
     },
     "captcha_id": {
      "$ref": "./common.json#/components/schemas/UUID"
     },
     "captcha_code": {
      "type": "string",
      "minLength": 4,
      "maxLength": 4,
      "pattern": "^[23456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz]{4}$"
     }
    },
    "dependentRequired": {
     "captcha_id": [
      "captcha_code"
     ],
     "captcha_code": [
      "captcha_id"
     ]
    }
   },
   "ForgotPasswordResult": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "sent",
     "expires_in"
    ],
    "properties": {
     "sent": {
      "const": false
     },
     "expires_in": {
      "const": 900
     },
     "dev_token": {
      "type": "string",
      "maxLength": 128,
      "x-development-only": true,
      "x-sensitive": true
     }
    }
   },
   "ResetPasswordWithToken": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "token",
     "new_password"
    ],
    "properties": {
     "token": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "writeOnly": true
     },
     "new_password": {
      "type": "string",
      "minLength": 6,
      "maxLength": 72,
      "writeOnly": true,
      "x-max-utf8-bytes": 72
     }
    }
   },
   "ResetPasswordResult": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "reset"
    ],
    "properties": {
     "reset": {
      "const": true
     }
    }
   },
   "Session": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "access_token",
     "expires_in",
     "csrf_token",
     "principal"
    ],
    "properties": {
     "access_token": {
      "type": "string",
      "readOnly": true
     },
     "expires_in": {
      "const": 900
     },
     "csrf_token": {
      "type": "string",
      "readOnly": true
     },
     "principal": {
      "$ref": "#/components/schemas/Principal"
     }
    }
   },
   "Refresh": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "audience"
    ],
    "properties": {
     "audience": {
      "enum": [
       "creator",
       "admin"
      ]
     }
    }
   },
   "LogoutResult": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "revoked"
    ],
    "properties": {
     "revoked": {
      "type": "boolean"
     }
    }
   },
   "CSRF": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "csrf_token"
    ],
    "properties": {
     "csrf_token": {
      "type": "string",
      "maxLength": 128
     }
    }
   },
   "WSTicket": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "ticket",
     "expires_in"
    ],
    "properties": {
     "ticket": {
      "type": "string",
      "maxLength": 128
     },
     "expires_in": {
      "const": 60
     }
    }
   },
   "Member": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "revision",
     "created_at",
     "updated_at",
     "user_id",
     "email",
     "display_name",
     "roles",
     "status"
    ],
    "properties": {
     "id": {
      "$ref": "./common.json#/components/schemas/UUID"
     },
     "revision": {
      "$ref": "./common.json#/components/schemas/Revision"
     },
     "created_at": {
      "$ref": "./common.json#/components/schemas/Timestamp"
     },
     "updated_at": {
      "$ref": "./common.json#/components/schemas/Timestamp"
     },
     "user_id": {
      "$ref": "./common.json#/components/schemas/UUID"
     },
     "email": {
      "type": "string",
      "format": "email"
     },
     "display_name": {
      "type": "string",
      "maxLength": 60
     },
     "roles": {
      "type": "array",
      "items": {
       "enum": [
        "creator",
        "operator",
        "auditor"
       ]
      },
      "minItems": 1,
      "uniqueItems": true
     },
     "status": {
      "enum": [
       "active",
       "disabled"
      ]
     }
    }
   },
   "CreateMember": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "email",
     "display_name",
     "password",
     "roles"
    ],
    "properties": {
     "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254
     },
     "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
     },
     "password": {
      "type": "string",
      "minLength": 6,
      "maxLength": 72,
      "writeOnly": true,
      "x-max-utf8-bytes": 72
     },
     "roles": {
      "type": "array",
      "items": {
       "enum": [
        "creator",
        "operator",
        "auditor"
       ]
      },
      "minItems": 1,
      "uniqueItems": true
     }
    }
   },
   "UpdateMember": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "expected_revision",
     "roles",
     "status"
    ],
    "properties": {
     "expected_revision": {
      "$ref": "./common.json#/components/schemas/Revision"
     },
     "roles": {
      "type": "array",
      "items": {
       "enum": [
        "creator",
        "operator",
        "auditor"
       ]
      },
      "minItems": 1,
      "uniqueItems": true
     },
     "status": {
      "enum": [
       "active",
       "disabled"
      ]
     }
    }
   },
   "ResetPassword": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "expected_revision",
     "new_password"
    ],
    "properties": {
     "expected_revision": {
      "$ref": "./common.json#/components/schemas/Revision"
     },
     "new_password": {
      "type": "string",
      "minLength": 6,
      "maxLength": 72,
      "writeOnly": true,
      "x-max-utf8-bytes": 72
     }
    }
   },
   "RevisionCommand": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "expected_revision"
    ],
    "properties": {
     "expected_revision": {
      "$ref": "./common.json#/components/schemas/Revision"
     }
    }
   },
   "RevokeSessions": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "revoked_count",
     "revision"
    ],
    "properties": {
     "revoked_count": {
      "type": "integer",
      "minimum": 0
     },
     "revision": {
      "$ref": "./common.json#/components/schemas/Revision"
     }
    }
   },
   "SecretReference": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "kind",
     "display_name",
     "configured",
     "allowed_consumers"
    ],
    "properties": {
     "id": {
      "type": "string",
      "maxLength": 200
     },
     "kind": {
      "enum": [
       "env",
       "secretstore"
      ]
     },
     "display_name": {
      "type": "string",
      "maxLength": 120
     },
     "configured": {
      "type": "boolean"
     },
     "allowed_consumers": {
      "type": "array",
      "items": {
       "enum": [
        "llm",
        "mcp"
       ]
      }
     }
    }
   },
   "File": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "revision",
     "created_at",
     "updated_at",
     "filename",
     "media_type",
     "purpose",
     "size_bytes",
     "sha256",
     "expires_at",
     "deleted_at"
    ],
    "properties": {
     "id": {
      "$ref": "./common.json#/components/schemas/UUID"
     },
     "revision": {
      "$ref": "./common.json#/components/schemas/Revision"
     },
     "created_at": {
      "$ref": "./common.json#/components/schemas/Timestamp"
     },
     "updated_at": {
      "$ref": "./common.json#/components/schemas/Timestamp"
     },
     "filename": {
      "type": "string",
      "maxLength": 180
     },
     "media_type": {
      "type": "string",
      "maxLength": 100
     },
     "purpose": {
      "enum": [
       "import",
       "inspiration_source",
       "export",
       "audit_export"
      ]
     },
     "size_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 104857600
     },
     "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     },
     "expires_at": {
      "anyOf": [
       {
        "$ref": "./common.json#/components/schemas/Timestamp"
       },
       {
        "type": "null"
       }
      ]
     },
     "deleted_at": {
      "anyOf": [
       {
        "$ref": "./common.json#/components/schemas/Timestamp"
       },
       {
        "type": "null"
       }
      ]
     }
    }
   },
   "Upload": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "file",
     "purpose"
    ],
    "properties": {
     "file": {
      "type": "string",
      "format": "binary"
     },
     "purpose": {
      "enum": [
       "import",
       "inspiration_source"
      ]
     },
     "novel_id": {
      "$ref": "./common.json#/components/schemas/UUID"
     }
    }
   },
   "Audit": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "actor_id",
     "audience",
     "action",
     "resource_id",
     "outcome",
     "request_id",
     "trace_id",
     "safe_changes",
     "created_at"
    ],
    "properties": {
     "id": {
      "$ref": "./common.json#/components/schemas/UUID"
     },
     "actor_id": {
      "anyOf": [
       {
        "$ref": "./common.json#/components/schemas/UUID"
       },
       {
        "type": "null"
       }
      ]
     },
     "audience": {
      "enum": [
       "creator",
       "admin",
       "system"
      ]
     },
     "action": {
      "type": "string",
      "maxLength": 100
     },
     "resource_id": {
      "anyOf": [
       {
        "$ref": "./common.json#/components/schemas/UUID"
       },
       {
        "type": "null"
       }
      ]
     },
     "outcome": {
      "enum": [
       "succeeded",
       "denied",
       "failed"
      ]
     },
     "request_id": {
      "$ref": "./common.json#/components/schemas/UUID"
     },
     "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
     },
     "safe_changes": {
      "type": "array",
      "maxItems": 100,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "field",
        "before",
        "after"
       ],
       "properties": {
        "field": {
         "type": "string",
         "maxLength": 120
        },
        "before": {
         "type": [
          "string",
          "null"
         ],
         "maxLength": 512
        },
        "after": {
         "type": [
          "string",
          "null"
         ],
         "maxLength": 512
        }
       }
      }
     },
     "created_at": {
      "$ref": "./common.json#/components/schemas/Timestamp"
     }
    }
   },
   "Status": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "observed_at",
     "service_version",
     "state",
     "dependencies",
     "queue",
     "outbox"
    ],
    "properties": {
     "observed_at": {
      "$ref": "./common.json#/components/schemas/Timestamp"
     },
     "service_version": {
      "type": "string",
      "maxLength": 80
     },
     "state": {
      "enum": [
       "ready",
       "degraded",
       "not_ready"
      ]
     },
     "dependencies": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "name",
        "state",
        "checked_at"
       ],
       "properties": {
        "name": {
         "enum": [
          "postgres",
          "redis"
         ]
        },
        "state": {
         "enum": [
          "healthy",
          "unavailable"
         ]
        },
        "checked_at": {
         "$ref": "./common.json#/components/schemas/Timestamp"
        }
       }
      }
     },
     "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "queued",
       "leased",
       "failed",
       "oldest_wait_seconds"
      ],
      "properties": {
       "queued": {
        "type": "integer",
        "minimum": 0
       },
       "leased": {
        "type": "integer",
        "minimum": 0
       },
       "failed": {
        "type": "integer",
        "minimum": 0
       },
       "oldest_wait_seconds": {
        "type": [
         "integer",
         "null"
        ],
        "minimum": 0
       }
      }
     },
     "outbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "pending",
       "dead_letter"
      ],
      "properties": {
       "pending": {
        "type": "integer",
        "minimum": 0
       },
       "dead_letter": {
        "type": "integer",
        "minimum": 0
       }
      }
     }
    }
   },
   "ChangePassword": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "current_password",
     "new_password",
     "expected_revision"
    ],
    "properties": {
     "current_password": {
      "type": "string",
      "writeOnly": true
     },
     "new_password": {
      "type": "string",
      "minLength": 6,
      "maxLength": 72,
      "writeOnly": true,
      "x-max-utf8-bytes": 72
     },
     "expected_revision": {
      "$ref": "./common.json#/components/schemas/Revision"
     }
    }
   }
  }
 }
}
