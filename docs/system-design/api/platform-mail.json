 "components": {
  "schemas": {
   "EmailCapabilities": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "enabled": {
      "type": "boolean"
     },
     "code_length": {
      "const": 6
     },
     "expires_in": {
      "const": 300
     },
     "retry_after_seconds": {
      "const": 60
     }
    },
    "required": [
     "enabled",
     "code_length",
     "expires_in",
     "retry_after_seconds"
    ]
   },
   "EmailChallengeRequest": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254
     },
     "purpose": {
      "type": "string",
      "enum": [
       "login",
       "register",
       "reset"
      ]
     },
     "audience": {
      "type": "string",
      "enum": [
       "creator",
       "admin"
      ]
     },
     "tenant_id": {
      "$ref": "./common.json#/components/schemas/UUID"
     }
    },
    "required": [
     "email",
     "purpose",
     "audience"
    ]
   },
   "EmailChallengeResult": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "challenge_id": {
      "$ref": "./common.json#/components/schemas/UUID"
     },
     "expires_at": {
      "type": "string",
      "format": "date-time"
     },
     "retry_after_seconds": {
      "const": 60
     }
    },
    "required": [
     "challenge_id",
     "expires_at",
     "retry_after_seconds"
    ]
   },
   "EmailLogin": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254
     },
     "challenge_id": {
      "$ref": "./common.json#/components/schemas/UUID"
     },
     "code": {
      "type": "string",
      "minLength": 6,
      "maxLength": 6,
      "pattern": "^[0-9]{6}$",
      "writeOnly": true
     },
     "audience": {
      "type": "string",
      "enum": [
       "creator",
       "admin"
      ]
     },
     "tenant_id": {
      "$ref": "./common.json#/components/schemas/UUID"
     },
     "captcha_id": {
      "$ref": "./common.json#/components/schemas/UUID"
     },
     "captcha_code": {
      "type": "string",
      "minLength": 4,
      "maxLength": 4
     }
    },
    "required": [
     "email",
     "challenge_id",
     "code",
     "audience"
    ],
    "dependentRequired": {
     "captcha_id": [
      "captcha_code"
     ],
     "captcha_code": [
      "captcha_id"
     ]
    }
   },
   "MailSettings": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "provider": {
      "type": "string",
      "enum": [
       "disabled",
       "smtp",
       "resend"
      ]
     },
     "enabled": {
      "type": "boolean"
     },
     "smtp_host": {
      "type": "string",
      "maxLength": 253
     },
     "smtp_port": {
      "type": "integer",
      "enum": [
       0,
       465,
       587
      ]
     },
     "smtp_security": {
      "type": "string",
      "enum": [
       "",
       "implicit_tls",
       "starttls"
      ]
     },
     "smtp_username": {
      "type": "string",
      "maxLength": 254
     },
     "sender_email": {
      "type": "string",
      "maxLength": 254
     },
     "sender_name": {
      "type": "string",
      "maxLength": 120
     },
     "has_credential": {
      "type": "boolean"
     },
     "credential_kind": {
      "type": "string",
      "enum": [
       "",
       "env",
       "encrypted"
      ]
     },
     "revision": {
      "$ref": "./common.json#/components/schemas/Revision"
     },
     "updated_at": {
      "type": "string",
      "format": "date-time"
     }
    },
    "required": [
     "provider",
     "enabled",
     "smtp_host",
     "smtp_port",
     "smtp_security",
     "smtp_username",
     "sender_email",
     "sender_name",
     "has_credential",
     "credential_kind",
     "revision",
     "updated_at"
    ]
   },
   "MailCredentialChange": {
    "oneOf": [
     {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "kind": {
        "const": "env"
       },
       "locator": {
        "type": "string",
        "pattern": "^MAIL_CREDENTIAL_[A-Z0-9_]{1,80}$",
        "writeOnly": true
       }
      },
      "required": [
       "kind",
       "locator"
      ]
     },
     {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "kind": {
        "const": "encrypted"
       },
       "value": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192,
        "writeOnly": true
       }
      },
      "required": [
       "kind",
       "value"
      ]
     }
    ]
   },
   "UpdateMailSettings": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "provider": {
      "type": "string",
      "enum": [
       "disabled",
       "smtp",
       "resend"
      ]
     },
     "enabled": {
      "type": "boolean"
     },
     "smtp_host": {
      "type": "string",
      "maxLength": 253
     },
     "smtp_port": {
      "type": "integer",
      "enum": [
       0,
       465,
       587
      ]
     },
     "smtp_security": {
      "type": "string",
      "enum": [
       "",
       "implicit_tls",
       "starttls"
      ]
     },
     "smtp_username": {
      "type": "string",
      "maxLength": 254
     },
     "sender_email": {
      "type": "string",
      "maxLength": 254
     },
     "sender_name": {
      "type": "string",
      "maxLength": 120
     },
     "expected_revision": {
      "$ref": "./common.json#/components/schemas/Revision"
     },
     "credential": {
      "$ref": "./platform-mail.json#/components/schemas/MailCredentialChange"
     }
    },
    "required": [
     "expected_revision",
     "provider",
     "enabled"
    ]
   },
   "TestMailSettings": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "expected_revision": {
      "$ref": "./common.json#/components/schemas/Revision"
     }
    },
    "required": [
     "expected_revision"
    ]
   },
   "TestMailResult": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "delivery_id": {
      "$ref": "./common.json#/components/schemas/UUID"
     },
     "accepted": {
      "const": true
     }
    },
    "required": [
     "delivery_id",
     "accepted"
    ]
   }
  }
 }
}
