{
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "CreatorRefreshCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "inklore_creator_refresh"
      },
      "AdminRefreshCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "inklore_admin_refresh"
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "每个逻辑副作用命令一个UUID，24小时同键重放",
        "schema": {
          "$ref": "#/components/schemas/UUID"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "schema": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "ExpectedRevision": {
        "name": "expected_revision",
        "in": "query",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/Revision"
        }
      }
    },
    "schemas": {
      "UUID": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "Revision": {
        "type": "integer",
        "format": "int64",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "Timestamp": {
        "type": "string",
        "format": "date-time",
        "pattern": "Z$"
      },
      "SuccessMeta": {
        "type": "object",
        "required": [
          "code",
          "request_id",
          "trace_id"
        ],
        "properties": {
          "code": {
            "const": "ok"
          },
          "request_id": {
            "$ref": "#/components/schemas/UUID"
          },
          "trace_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          }
        }
      },
      "FieldError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "reason"
        ],
        "properties": {
          "field": {
            "type": "string",
            "maxLength": 256
          },
          "reason": {
            "type": "string",
            "maxLength": 120
          }
        }
      },
      "ErrorDetails": {
        "type": "object",
        "properties": {
          "field_errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "maxItems": 100
          },
          "current_revision": {
            "$ref": "#/components/schemas/Revision"
          },
          "retry_after_seconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400
          },
          "operation_id": {
            "$ref": "#/components/schemas/UUID"
          },
          "conflicts": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "resource_id",
                "reason"
              ],
              "properties": {
                "resource_id": {
                  "$ref": "#/components/schemas/UUID"
                },
                "reason": {
                  "type": "string",
                  "maxLength": 120
                },
                "current_revision": {
                  "$ref": "#/components/schemas/Revision"
                }
              }
            }
          }
        },
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message_key",
          "details",
          "request_id",
          "trace_id"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^(platform|auth|content|outline|worldview|inspiration|compliance|agent|llm)\\.[a-z][a-z0-9_]+$"
          },
          "message_key": {
            "type": "string",
            "pattern": "^errors\\."
          },
          "details": {
            "$ref": "#/components/schemas/ErrorDetails"
          },
          "request_id": {
            "$ref": "#/components/schemas/UUID"
          },
          "trace_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          }
        }
      },
      "PageMeta": {
        "type": "object",
        "required": [
          "next_cursor",
          "has_more"
        ],
        "properties": {
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2048
          },
          "has_more": {
            "type": "boolean"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "400 请求格式、缺少前置或游标错误",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "401 会话无效/到期",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "403 明确权限不足",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "404 资源不存在或不可见",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "409 版本/状态/幂等冲突",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "PayloadTooLarge": {
        "description": "413 请求或文件体积超限",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ValidationFailed": {
        "description": "422 领域约束不满足",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "429 限流/预算不足",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "InternalError": {
        "description": "500 未知错误；不返回内部根因",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "BadGateway": {
        "description": "502 上游协议错误",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unavailable": {
        "description": "503 依赖不可用",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "GatewayTimeout": {
        "description": "504 上游超时",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Gone": {
        "description": "410 SSE游标已过期",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "已知路径不支持该HTTP方法；Allow列出允许方法",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
