# ── 环境与密钥 ──────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── 构建产物 ───────────────────────────────────────────────
bin/
dist/
dist-admin/
frontend/dist/
frontend/dist-admin/
build/
