# Render Free Staging: never seeds, migrates, or embeds credentials.
FROM golang:1.27.1-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' -o /out/server ./cmd/server

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata wget \
    && adduser -D -u 10001 -s /sbin/nologin inklore
WORKDIR /app
COPY --from=build /out/server /app/server
COPY --from=build /src/configs/config.example.yaml /app/configs/config.yaml
COPY deploy/render/entrypoint.sh /app/entrypoint.sh
RUN chmod 0555 /app/entrypoint.sh
USER inklore
ENV APP_ENV=production PORT=10000 HTTP_ADDR=0.0.0.0:10000 MIGRATE_ON_START=false
EXPOSE 10000
HEALTHCHECK --interval=30s --timeout=5s --start-period=35s --retries=3 \
  CMD wget -qO- http://127.0.0.1:10000/healthz >/dev/null || exit 1
ENTRYPOINT ["/app/entrypoint.sh"]
