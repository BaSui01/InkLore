# Admin-only Vite static bundle; Creator assets are NOT included.
FROM node:22-alpine AS build
RUN npm install -g pnpm@11.25.0
WORKDIR /src
COPY frontend ./frontend
WORKDIR /src/frontend
RUN pnpm install --frozen-lockfile
RUN pnpm run build:admin

FROM nginx:1.28-alpine
COPY --from=build /src/frontend/dist-admin/ /usr/share/nginx/html/
# Keep the admin application's built absolute asset paths, but serve its
# entry document at / for its own dedicated Railway subdomain.
RUN mv /usr/share/nginx/html/admin.html /usr/share/nginx/html/index.html
COPY deploy/staging/nginx.conf.template /etc/nginx/nginx.conf.template
ENV PORT=8080
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz >/dev/null || exit 1
CMD test -n "$API_UPSTREAM" && NGINX_RESOLVER=$(awk '/^nameserver/{print $2; exit}' /etc/resolv.conf) && test -n "$NGINX_RESOLVER" && envsubst '$PORT $API_UPSTREAM $NGINX_RESOLVER' < /etc/nginx/nginx.conf.template > /etc/nginx/nginx.conf && nginx -t && exec nginx -g 'daemon off;'
