# Staging-only image: does not execute migrations, seed users, or embed secrets.
FROM golang:1.27.1-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/server ./cmd/server

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata wget \
    && adduser -D -u 10001 -s /sbin/nologin inklore
WORKDIR /app
COPY --from=build /out/server /app/server
# Bootstrap requires a mounted config file in production. Copy ONLY the
# nonsecret template; real DATABASE_DSN and security keys come from Railway env.
COPY --from=build /src/configs/config.example.yaml /app/configs/config.yaml
ENV APP_ENV=production HTTP_ADDR=0.0.0.0:8080 MIGRATE_ON_START=false PORT=8080
USER inklore
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=4s --start-period=35s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz >/dev/null || exit 1
ENTRYPOINT ["/app/server"]
