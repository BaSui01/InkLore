# InkLore 环境变量示例
#
# 使用：cp .env.example .env 后按需填写。.env 已被 .gitignore 忽略，不会进入版本库。
# 完整配置文件模板见 configs/config.example.yaml；二者字段一一对应，环境变量优先级更高。
# 注意：所有模型供应商密钥严禁入库、严禁打印日志、严禁返回前端（见 ADR-0004）。

# ── 应用 ────────────────────────────────────────────────────
# ── 后端服务端口（不常用高位专属端口） ─────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=29080
APP_DEBUG=false

# ── 前端双端端口与反向代理（全项目统一根目录单一事实来源） ─────────
VITE_BACKEND_PORT=29080
VITE_CREATOR_PORT=29000
VITE_ADMIN_PORT=29001
VITE_BACKEND_URL=http://127.0.0.1:29080

# ── PostgreSQL（与 docker-compose.dev.yml 默认凭据一致）────────
DATABASE_DRIVER=postgres
DATABASE_DSN=postgres://ai_novel:change-me@127.0.0.1:5432/ai_novel?sslmode=disable
DB_MAX_OPEN_CONNS=40
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=1800
DB_CONN_MAX_IDLE_TIME=600
DB_SLOW_THRESHOLD_MS=200

# ── 存储档位（INK-108 / ADR-0012）──────────────────────────────
# 数据库是唯一权威存储：未配置 DATABASE_DSN 时进程直接拒绝启动（含开发环境）。
# 仅当显式设为 true 时才允许降级为内存仓储——该档位下所有业务数据只在进程内，
# 重启即丢失，只可用于离线联调，绝不可用于任何真实创作。
ALLOW_MEMORY_STORE=false

# ── Redis ───────────────────────────────────────────────────
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── 安全（生产环境必填）──────────────────────────────────────
# 32 字节密钥，生成方式：openssl rand -base64 32 | head -c 32
ENCRYPTION_KEY=
JWT_SECRET=
BCRYPT_COST=10
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# ── 日志 ────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=text
LOG_OUTPUT=stdout

# ── 模型供应商密钥（只允许环境变量注入）────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
# 单一渠道直连模式：openai / deepseek / anthropic / gemini / ollama。
LLM_PROTOCOL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# 仅对 LLM_PROTOCOL=openai 生效；设置为 responses 时调用 OpenAI Responses API。
LLM_OPENAI_API=

# ── 多渠道选路（可选）────────────────────────────────────────
# 配置后启用多 Key 选路 / 加权负载 / 限流 / 熔断；留空则退化为下方单一 Key 直连。
# keys[].name 是"持有密钥的环境变量名"，此处不写明文密钥（ADR-0004）。
# 多渠道配置：provider 只能为 openai/deepseek/anthropic/gemini/ollama；protocol 是可选的内部 transport。
# 仅 openai 可使用 openai_responses；仅 gemini 可使用 gemini_interactions 或 gemini_openai。
# keys[].name 必须是已部署的环境变量名，绝不写入 API Key 正文。priority 越小越优先。
# LLM_CHANNELS=[{"name":"openai-primary","provider":"openai","protocol":"openai_responses","base_url":"https://api.openai.com/v1","weight":1,"priority":0,"models":["gpt-5.2"],"keys":[{"name":"OPENAI_API_KEY","rate_limit":60,"concurrency_limit":4}]},{"name":"deepseek-backup","provider":"deepseek","base_url":"https://api.deepseek.com","weight":1,"priority":10,"models":["deepseek-chat"],"keys":[{"name":"DEEPSEEK_API_KEY"}]}]
# 模型渠道与密钥由管理员在系统管理端统一配置入库，此处无需配置 LLM_CHANNELS

# ── 嵌入模型（语义召回，INK-017 / ADR-0010）──────────────────
# EMBEDDING_DIMENSIONS 必须与 novel_embeddings.embedding 的列维度一致（默认 1536）。
# 模型原生维度不同（如 Qwen3-Embedding-4B 为 2560）时由上游按 dimensions 参数 MRL 截断；
# 取非默认值时服务启动会告警，改维度必须同时迁移向量列并重建 HNSW 索引。
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── 写作与摘要模型（INK-070 / INK-072）───────────────────────
# 这两项是**兜底**：真正生效的是任务级模型策略（INK-066 / ADR-0013），
# 在控制台「LLM → 任务模型策略」或 PUT /v1/llm/task-policies/:taskKey 配置。
# 解析顺序恒为：调用方显式 model > 任务策略 > 这里的默认值；三挡都空则明确报错。
# 未配置时摘要会退化为本地抽取式摘要（source=extractive，不伪装成模型输出），
# 写作工具则返回明确的失败观察（不产出模板文本冒充 AI 改写）。
WRITING_TOOL_MODEL=
SUMMARY_MODEL=

# ── 认证（AUTH_MODE）─────────────────────────────────────────
# required：无有效令牌一律 401（生产默认）；disabled：不强制（开发默认）。
# 令牌签名密钥 JWT_SECRET 未设置时回退 ENCRYPTION_KEY。
# 联调签发令牌：go run ./cmd/tokengen -sub user:alice -tid tenant-a
AUTH_MODE=

# ── 启动期自动迁移 ───────────────────────────────────────────
# 开发环境默认开启（冷启动即建表）；生产默认关闭，由部署流程显式执行 cmd/migrate，
# 避免多实例并发启动互相抢迁移。
MIGRATE_ON_START=

# ── 运行时开关（由基础设施层直读，不属于配置中心字段）──────────
# 未配置 Provider 时是否允许内置模板引擎做离线演示。默认 false：生成请求明确失败。
# 开启后输出为模板推演（ProviderInfo 会标记 template_based），绝不可作为创作结果使用。
LLM_BUILTIN_FALLBACK=false

# ── HTTP 监听覆盖（留空则使用 APP_HOST / APP_PORT）────────────
HTTP_ADDR=
